generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COMERCIAL
  VISUALIZACAO
}

enum ProposalStatus {
  RASCUNHO
  REVISAO
  ENVIADA
  VISUALIZADA
  EM_NEGOCIACAO
  APROVADA
  PERDIDA
}

enum Priority {
  CRITICA
  ALTA
  MEDIA
  BAIXA
}

enum Recurrence {
  ONE_TIME
  MONTHLY
  YEARLY
}

enum TemplateKey {
  DARK
  EXECUTIVE
  MINIMAL
  FUTURE
}

model Organization {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  primaryColor   String   @default("#5E2BFF")
  secondaryColor String   @default("#2563EB")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users     User[]
  clients   Client[]
  services  Service[]
  packages  Package[]
  templates ProposalTemplate[]
  proposals Proposal[]
  settings  OrganizationSettings?
}

model OrganizationSettings {
  id             String @id @default(cuid())
  organizationId String @unique
  noWebsiteCopy  String @default("A ausência de um site representa uma oportunidade de construção de autoridade, presença digital e geração de oportunidades.")
  defaultCta     String @default("Pronto para o próximo nível?")
  whatsappUrl    String?
  meetingUrl     String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  email          String   @unique
  passwordHash   String
  role           Role     @default(COMERCIAL)
  image          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposals    Proposal[]

  @@index([organizationId])
}

model Client {
  id             String  @id @default(cuid())
  organizationId String
  companyName    String
  tradeName      String?
  segment        String?
  contactName    String?
  contactRole    String?
  phone          String?
  whatsapp       String?
  email          String?
  city           String?
  state          String?
  website        String?
  instagram      String?
  facebook       String?
  tiktok         String?
  googleMaps     String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposals    Proposal[]

  @@index([organizationId, createdAt])
}

model Service {
  id             String     @id @default(cuid())
  organizationId String
  slug           String
  name           String
  tagline        String
  description    String
  benefits       String[]
  deliverables   String[]
  defaultPrice   Int
  recurrence     Recurrence @default(MONTHLY)
  active         Boolean    @default(true)
  sortOrder      Int        @default(0)

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposalServices ProposalService[]

  @@unique([organizationId, slug])
}

model Package {
  id             String  @id @default(cuid())
  organizationId String
  slug           String
  name           String
  monthlyPrice   Int
  setupPrice     Int     @default(0)
  description    String
  highlights     String[]
  recommended    Boolean @default(false)
  active         Boolean @default(true)
  sortOrder      Int     @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposals    Proposal[]

  @@unique([organizationId, slug])
}

model ProposalTemplate {
  id             String      @id @default(cuid())
  organizationId String
  key            TemplateKey
  name           String
  description    String
  active         Boolean     @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
}

model Proposal {
  id               String         @id @default(cuid())
  organizationId   String
  clientId         String
  ownerId          String
  packageId        String?
  number           Int            @default(autoincrement())
  title            String
  slug             String
  publicToken      String         @unique
  status           ProposalStatus @default(RASCUNHO)
  templateKey      TemplateKey    @default(DARK)
  coverHeadline    String         @default("Transformando presença digital em crescimento.")
  coverSubheadline String?
  monthlyValue     Int            @default(0)
  setupValue       Int            @default(0)
  discountValue    Int            @default(0)
  durationMonths   Int            @default(12)
  validUntil       DateTime?
  publishedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  owner        User                @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  package      Package?            @relation(fields: [packageId], references: [id], onDelete: SetNull)
  diagnostic   Diagnostic?
  sections     ProposalSection[]
  services     ProposalService[]
  problems     Problem[]
  opportunities Opportunity[]
  views        ProposalView[]
  events       ProposalEvent[]
  acceptance   ProposalAcceptance?

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([clientId])
}

model ProposalSection {
  id         String  @id @default(cuid())
  proposalId String
  type       String
  title      String
  subtitle   String?
  body       String?
  content    Json?
  sortOrder  Int
  visible    Boolean @default(true)

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, sortOrder])
}

model ProposalService {
  id         String @id @default(cuid())
  proposalId String
  serviceId  String
  quantity   Int    @default(1)
  price      Int
  notes      String?

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([proposalId, serviceId])
}

model Diagnostic {
  id                String  @id @default(cuid())
  proposalId        String  @unique
  instagramScore    Int?
  googleScore       Int?
  websiteScore      Int?
  contentScore      Int?
  positioningScore  Int?
  conversionScore   Int?
  overallScore      Int?
  interpretation    String?
  hasWebsite        Boolean @default(false)
  noWebsiteCopy     String?

  proposal          Proposal           @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  instagramAnalysis InstagramAnalysis?
  googleAnalysis    GoogleAnalysis?
  websiteAnalysis   WebsiteAnalysis?
}

model InstagramAnalysis {
  id                 String  @id @default(cuid())
  diagnosticId       String  @unique
  followers          Int?
  following          Int?
  posts              Int?
  avgLikes           Int?
  avgComments        Decimal? @db.Decimal(10, 2)
  engagementRate     Decimal? @db.Decimal(6, 2)
  postingFrequency   String?
  avgReach           Int?
  avgViews           Int?
  bestContent        String?
  worstContent       String?
  visualQuality      Int?
  contentQuality     Int?
  positioning        String?
  bio                String?
  cta                String?
  highlights         String?
  visualIdentity     String?

  diagnostic Diagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
}

model GoogleAnalysis {
  id                    String  @id @default(cuid())
  diagnosticId          String  @unique
  hasBusinessProfile    Boolean @default(false)
  reviewCount           Int?
  rating                Decimal? @db.Decimal(3, 2)
  reviewFrequency       String?
  photos                Int?
  infoUpdated           Boolean?
  appearsOnGoogle       Boolean?
  localPositioning      String?
  competitors           String?
  searchPresence        String?
  seoOpportunities      String?

  diagnostic Diagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
}

model WebsiteAnalysis {
  id             String  @id @default(cuid())
  diagnosticId   String  @unique
  url            String?
  visualQuality  Int?
  speed          Int?
  responsiveness Int?
  seo            Int?
  structure      Int?
  copywriting    Int?
  cta            Int?
  conversion     Int?
  mobileExperience Int?

  diagnostic Diagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
}

model Problem {
  id          String   @id @default(cuid())
  proposalId  String
  title       String
  description String
  impact      String
  evidence    String
  priority    Priority @default(ALTA)
  sortOrder   Int      @default(0)

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, sortOrder])
}

model Opportunity {
  id          String   @id @default(cuid())
  proposalId  String
  category    String
  title       String
  description String
  impact      String
  complexity  String
  priority    Priority @default(ALTA)
  sortOrder   Int      @default(0)

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, sortOrder])
}

model ProposalView {
  id         String   @id @default(cuid())
  proposalId String
  sessionId  String
  startedAt  DateTime @default(now())
  endedAt    DateTime?
  durationSeconds Int?
  ipHash     String?
  userAgent  String?

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, startedAt])
}

model ProposalEvent {
  id         String   @id @default(cuid())
  proposalId String
  sessionId  String
  type       String
  section    String?
  metadata   Json?
  createdAt  DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, createdAt])
  @@index([proposalId, type])
}

model ProposalAcceptance {
  id           String   @id @default(cuid())
  proposalId   String   @unique
  name         String
  role         String
  email        String
  phone        String?
  agreed       Boolean
  signature    String?
  ip           String?
  acceptedAt   DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
}
